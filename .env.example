# ============================================================
#  免费 AI 模型雷达 —— 密钥模板
# ------------------------------------------------------------
#  用法（三步）：
#    1. 把本文件【复制】一份，命名为  .env.local
#    2. 打开 .env.local，填写你手上有的 key；没有的留空即可
#    3. 告诉我「填好了」
#
#  ⚠️ 本文件（.env.example）是空模板，可以进 Git
#  ⚠️ .env.local 已被 .gitignore 忽略，【绝不会】被提交到 GitHub
#  ⚠️ 只有 .env.local 才放真 key，不要改本文件
#
#  留空的平台不会报错，只会退化为「平台声明 / 官方文档核对」，
#  不做实际调用验证。填了哪个，我就对哪个平台做「实测通过」标记。
# ============================================================


# ┌────────────────────────────────────────────────────────────┐
# │  ★ 最划算的一个：一个 key 覆盖 20 个免费模型的实测          │
# └────────────────────────────────────────────────────────────┘
# 注册：https://openrouter.ai/keys   （免绑卡，可给 key 设额度上限）
OPENROUTER_API_KEY=


# ── Google AI Studio（Gemini 3.x Flash / Gemma 4 / embeddings）──
# 注册：https://aistudio.google.com/apikey   （免绑卡）
GEMINI_API_KEY=


# ── Groq（极低延迟：gpt-oss-120b / 20b、Qwen3.8 27B、Whisper）──
# 注册：https://console.groq.com/keys
GROQ_API_KEY=


# ── 智谱 BigModel（GLM-Flash 计费 ¥0，国内直连）──
# 注册：https://open.bigmodel.cn/
ZHIPU_API_KEY=


# ── 美团 LongCat（LongCat-2.5-Preview：1.6T 参数 / 1M 上下文 / 赠 500万 token）──
# 注册：https://longcat.chat/platform
LONGCAT_API_KEY=


# ── NVIDIA NIM（build.nvidia.com，100+ 开源模型，需手机验证）──
# 注册：https://build.nvidia.com/
NVIDIA_API_KEY=


# ── Mistral（每月 $10 API 额度）──
# 注册：https://console.mistral.ai/
MISTRAL_API_KEY=


# ── Cohere（trial key：约 1000 次/月）──
# 注册：https://dashboard.cohere.com/api-keys
COHERE_API_KEY=


# ── Cloudflare Workers AI（每天 1 万 Neurons，需要两个值）──
# 注册：https://dash.cloudflare.com/profile/api-tokens
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=


# ── Hugging Face（inference providers，200+ 模型）──
# 注册：https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=


# ── 商汤日日新（公测期免费，国内直连）──
# 注册：https://platform.sensenova.cn/
SENSENOVA_API_KEY=


# ── Agnes AI（永久免费 20 RPM，国内直连）──
# 注册：https://apihub.agnes-ai.com/
AGNES_API_KEY=
